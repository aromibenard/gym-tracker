generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String  @id @default(uuid())
  clerkId String  @unique
  name    String?
  email   String?

  exercises Exercise[]
  sessions  Session[]
  records   PersonalRecord[]

  createdAt DateTime @default(now())
}

model MuscleGroup {
  id   String @id @default(uuid())
  name String @unique

  exercises Exercise[]
}

model Exercise {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [clerkId])

  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  sets    Set[]
  records PersonalRecord[]

  createdAt DateTime @default(now())

  @@index(userId)
  @@index(muscleGroupId)
}

model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [clerkId])

  perfomedAt DateTime @default(now())
  notes      String?

  sets      Set[]
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([perfomedAt])
}

model Set {
  id String @id @default(uuid())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  weight Float
  reps   Int
  order  Int

  perfomedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([exerciseId])
  @@index([sessionId])
  @@index([perfomedAt])
}

model PersonalRecord {
  id String @id @default(uuid())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [clerkId])

  maxWeight Float
  maxReps   Int

  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@index([exerciseId])
}
